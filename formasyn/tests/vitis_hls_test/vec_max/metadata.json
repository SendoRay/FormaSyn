{
  "name": "vec_max",
  "description": "Vector max reduction (Reduce pattern)",
  "pattern": "reduce",
  "vector_size": 8,
  "target_ii": 1,
  "io": {
    "inputs": [
      {"name": "a", "type": "ap_int<16>", "size": 8, "direction": "in"}
    ],
    "outputs": [
      {"name": "y", "type": "ap_int<16>", "size": 1, "direction": "out"},
      {"name": "idx", "type": "ap_uint<3>", "size": 1, "direction": "out"}
    ]
  },
  "operation": "y = max(a[i]), idx = argmax",
  "accuracy_requirement": {
    "metric": "correctness",
    "threshold": 100,
    "unit": "%"
  }
}
