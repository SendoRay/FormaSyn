{
  "name": "vec_mul",
  "description": "Vector multiplication (Map pattern)",
  "pattern": "map",
  "vector_size": 8,
  "target_ii": 1,
  "io": {
    "inputs": [
      {"name": "a", "type": "ap_int<16>", "size": 8, "direction": "in"},
      {"name": "b", "type": "ap_int<16>", "size": 8, "direction": "in"}
    ],
    "outputs": [
      {"name": "y", "type": "ap_int<32>", "size": 8, "direction": "out"}
    ]
  },
  "operation": "y[i] = a[i] * b[i]",
  "accuracy_requirement": {
    "metric": "NMSE",
    "threshold": -50,
    "unit": "dB"
  }
}
